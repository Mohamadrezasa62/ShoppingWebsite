# Copy to .env.production, chmod 600, supply actual secrets. Never commit it.
RELEASE_TAG=replace-with-reviewed-git-sha
SITE_HOST=shop.example.com
ACME_EMAIL=operator@example.com
SITE_URL=https://shop.example.com
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=shop.example.com,api
CSRF_TRUSTED_ORIGINS=https://shop.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_TRUST_TLS_PROXY=1
DJANGO_HSTS_SECONDS=3600
POSTGRES_DB=shopping
POSTGRES_USER=shopping
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_HOST=db
DATABASE_PORT=5432
REDIS_URL=redis://redis:6379/0
AUTH_TRUSTED_PROXY_NETWORKS=172.30.91.10/32
SMS_BACKEND=disabled
# For approved templates/credentials change SMS_BACKEND to kavenegar.
KAVENEGAR_API_KEY=
KAVENEGAR_LOGIN_TEMPLATE=
KAVENEGAR_STAFF_PASSWORD_TEMPLATE=
ENABLE_SANDBOX_PAYMENTS=0
REQUEST_LOG_LEVEL=INFO

ZARINPAL_ENABLED=0
ZARINPAL_MERCHANT_ID=
